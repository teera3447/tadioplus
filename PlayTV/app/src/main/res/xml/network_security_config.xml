<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- สตรีมทีวีหลายเจ้าปล่อยเป็น http และ https แบบ redirect ข้ามโปรโตคอล -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
